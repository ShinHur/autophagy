# Public configuration template. Values are never committed; copy this file privately and fill it in.
# Missing or blank values fail closed instead of using private or deployment-specific defaults.
#
# Not every key is needed by every deployment. Grouped sections below are consumed by distinct
# components; a single-node install that never publishes managed skills, never runs the regression
# bank, and never runs the infrastructure-bound scenarios only needs the first six groups.
# `docs/dependencies.md` documents which component reads which key.
#
# `configs/rag/env.example` is configured separately for the retrieval subservice and is not
# merged into this file.

# Discord identity and channels
# Owner user ID; enable Discord Developer Mode and use Copy User ID on the owner account.
DISCORD_OWNER_ID=
# Deployment guild ID; use Copy Server ID on the Discord server.
DISCORD_GUILD_ID=
# Owner DM channel ID; read the channel ID from the Discord API response after opening the owner DM.
DISCORD_OWNER_DM_CHANNEL_ID=
# Approval channel ID; use Copy Channel ID on the deployment server's approvals channel.
DISCORD_APPROVALS_CHANNEL_ID=
# Agent bot user ID; use Copy User ID on the installed agent bot account.
DISCORD_BOT_USER_ID_AGENT=
# Peer bot user ID; use Copy User ID on the installed peer bot account.
DISCORD_BOT_USER_ID_PEER=
# Bot credential used to post approval messages and to poll approval reactions. Every approval and
# watcher path reads it from the protected environment and passes it explicitly to child processes;
# without it no approval message can be posted, so the approval flow fails closed rather than
# executing unapproved. Keep it out of any tracked file.
DISCORD_BOT_TOKEN=

# Deployment hosts and roots
# SSH hostname for the deployment node; use the hostname recorded in your infrastructure inventory.
DEPLOY_SSH_HOST=
# Absolute deployment checkout root; choose it during host provisioning.
AUTOPHAGY_DEPLOY_ROOT=
# Absolute private runtime-data root; choose a protected path during host provisioning.
AUTOPHAGY_PRIVATE_ROOT=
# Absolute live skills root; use the path configured by the skill deployment service.
AUTOPHAGY_SKILLS_ROOT=
# Absolute immutable runtime-release root; rendered into the repair systemd unit templates.
AUTOPHAGY_RUNTIME_ROOT=
# Absolute dedicated repair work clone; rendered into the repair systemd unit templates.
AUTOPHAGY_REPAIR_WORK_ROOT=
# Repository slug (owner/name); used for the deploy-key clone URL and the deploy-key settings page.
AUTOPHAGY_REPO_SLUG=

# Owner and organization metadata
# Owner delivery email; use the address configured for owner notifications.
OWNER_EMAIL=
# Public organization display label; choose the label shown in generated reports.
ORGANIZATION_LABEL=

# Google services
# Google Cloud project ID; copy it from the Google Cloud console project selector.
GCP_PROJECT_ID=
# Budget spreadsheet ID; copy the identifier between /d/ and /edit in the sheet URL.
BUDGET_SHEET_ID=

# Site mail integration
# Absolute site-mail backend config path; use the protected file created during mail provisioning.
SITE_MAIL_BACKEND_CONFIG=

# Model gateway budgets and credentials
# Monthly soft-alert budget in USD for the agent and peer model-gateway virtual keys.
LITELLM_SOFT_BUDGET=
# Monthly hard cap in USD for the agent and peer model-gateway virtual keys.
LITELLM_HARD_BUDGET=
# Absolute path to the credential file the repair planner reads for its model-gateway key.
REPAIR_LITELLM_KEY_FILE=

# Managed skill publishing
# Manifest publisher principal recorded in managed-skill releases.
MANAGED_PUBLISHER=
# Signing identity email used for managed-skill release tags.
MANAGED_PUBLISHER_EMAIL=
# Allowed SSH signing principal accepted during managed-skill verification.
MANAGED_PUBLISHER_PRINCIPAL=

# Health checks
# Absolute directory the healthcheck writes its logs to.
HEALTHCHECK_LOG_DIR=
# Primary service hostname probed by the healthcheck.
HEALTHCHECK_HOST_A=
# Secondary service hostname probed by the healthcheck.
HEALTHCHECK_HOST_B=
# SSH account used for healthcheck probes.
HEALTHCHECK_SSH_USER=
# Dashboard URL that must reject unauthenticated requests.
HEALTHCHECK_DASHBOARD_AUTH_URL=
# Absolute deployment checkout inspected by the mirror drift probe.
HEALTHCHECK_OPS_CHECKOUT=
# Absolute repair CLI path on the primary host.
HEALTHCHECK_REPAIR_CLI=
# Account the healthcheck repair CLI runs as on the primary host.
HEALTHCHECK_REPAIR_ACCOUNT=
# Expected retrieval collection name asserted by the healthcheck.
HEALTHCHECK_MCP_COLLECTION=
# Host serving the kanban and report-hub dashboards probed after a credential rotation; optional, defaults to the loopback address.
CREDENTIAL_ROTATION_DASHBOARD_HOST=

# Regression bank
# Primary deployment hostname for the regression bank.
REGRESSION_BANK_HOST_A=
# Secondary deployment hostname for the regression bank.
REGRESSION_BANK_HOST_B=
# Remote account used for regression-bank deployment.
REGRESSION_BANK_REMOTE_USER=
# Absolute remote regression-bank checkout path.
REGRESSION_BANK_HARNESS_ROOT=
# Absolute remote regression-bank runner path.
REGRESSION_BANK_RUNNER_PATH=
# Absolute remote regression-bank log directory.
REGRESSION_BANK_LOG_DIR=
# Absolute agent-side regression-bank runtime directory.
REGRESSION_BANK_RUNTIME_DIR=
# Absolute agent-side local binary directory.
REGRESSION_BANK_AGENT_BIN_DIR=
# Hostname the regression-bank runner reports its state to.
REGRESSION_BANK_STATE_HOST=

# Wiki migration helper
# Absolute legacy wiki source directory.
MIGRATE_WIKI_SOURCE_DIR=
# Destination path relative to the migration account home.
MIGRATE_WIKI_DEST_REL=
# Account that owns the migrated wiki.
MIGRATE_WIKI_RUN_USER=

# Infrastructure-bound end-to-end scenarios
# Deployment host for infrastructure-bound scenarios.
E2E_REMOTE_HOST=
# Remote primary test account for personal-memory, calendar, coordination, and report-hub scenarios.
E2E_PRIMARY_ACCOUNT=
# Remote peer test account for coordination and gate-interop scenarios.
E2E_PEER_ACCOUNT=
# Remote observer test account for report-hub scenarios.
E2E_OBSERVER_ACCOUNT=
# Approval audit-log path used by the calendar and coordination scenario actors.
E2E_APPROVAL_LOG=
# Chat guild name used by the coordination and report-hub scenario actors.
E2E_DISCORD_GUILD_NAME=
# Readable report-hub database path for the observer actor.
E2E_REPORT_HUB_DB=
# Dashboard URL for the observer actor.
E2E_REPORT_HUB_DASHBOARD_URL=
# Readable dashboard credential file path for the observer actor.
E2E_REPORT_HUB_CREDENTIALS=
