
[Unit]
Description=Autophagy report hub collector (W3-4, #agents-log -> SQLite)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ops/report-hub
Environment=PYTHONPATH=/home/ops/report-hub
EnvironmentFile=/home/ops/.env.secrets
EnvironmentFile=/home/ops/report-hub/hub.env
ExecStart=/usr/bin/python3 -m automation.report_hub.collector
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
