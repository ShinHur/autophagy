# Copy to `.env.secrets` next to compose.yaml and fill in real values.
# Never commit the filled-in file.

# Host interface the MCP API is published on (port 8765).
# Keep this a loopback or private-network address: the MCP server exposes the
# whole personal memory collection and is protected only by RAG_MCP_API_KEY.
# Do NOT use 0.0.0.0 unless the host has no public interface.
MCP_BIND_ADDRESS=127.0.0.1

# Bearer token the agent must present on every MCP request.
# Generate a fresh random value per deployment, e.g. `openssl rand -hex 32`.
RAG_MCP_API_KEY=replace-with-agent-only-secret
